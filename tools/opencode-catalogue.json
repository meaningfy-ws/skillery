  "agents": {
    "code-reviewer": {
      "name": "code-reviewer",
      "description": "Reviews a change through exactly one review lens (L1–L5) and reports prioritised findings; read-only. Use when a caller fans out a pre-PR review, one code-reviewer per lens (a full review is five dispatches, per meaningfy-code-review). Not for fixing code (implementer) or discussing findings.\n",
      "type": "delegated",
      "model": "opus",
      "color": "yellow",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash"
      ],
      "disallowedTools": [
        "Write",
        "Edit",
        "NotebookEdit"
      ],
      "skills": [
        "meaningfy-code-review",
        "cosmic-python"
      ]
    },
    "epic-planner": {
      "name": "epic-planner",
      "description": "Shapes an EPIC from human seeds and derives its clarity-gated PLAN (≥9/10) as an OpenSpec change, returning question rounds to the caller until no decision is open. Use when starting or refining an epic. Not for archiving or grooming living specs (spec-stewardship) or for writing code (implementer).\n",
      "type": "delegated",
      "model": "opus",
      "color": "cyan",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash",
        "Skill"
      ],
      "skills": [
        "epic-planning",
        "clarity-gate",
        "bdd-gherkin",
        "stream-coding"
      ]
    },
    "implementer": {
      "name": "implementer",
      "description": "Implements one ready task of an OpenSpec change as tested production code, test-first. Use when a task in tasks.md is ready (PLAN gated ≥9/10, Gherkin written). Not for planning (epic-planner), reviewing (code-reviewer) or committing.\n",
      "type": "delegated",
      "model": "sonnet",
      "color": "blue",
      "tools": [
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "Bash",
        "Skill"
      ],
      "skills": [
        "cosmic-python",
        "stream-coding",
        "superpowers:test-driven-development",
        "superpowers:systematic-debugging",
        "superpowers:verification-before-completion"
      ]
    }
  }
}
