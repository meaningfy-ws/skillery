    "code-reviewer": {
      "name": "code-reviewer",
      "description": "Reviews a change through exactly one review lens (L1–L5) and reports prioritised findings; read-only. Use when a caller fans out a pre-PR review, one code-reviewer per lens (a full review is five dispatches, per meaningfy-code-review). Not for fixing code (implementer) or discussing findings.\n",
      "type": "delegated",
      "model": "opus",
      "color": "yellow",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash"
      ],
      "disallowedTools": [
        "Write",
        "Edit",
        "NotebookEdit"
      ],
