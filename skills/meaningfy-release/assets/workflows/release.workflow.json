{
  "name": "release", "title": "Release", "owner": "meaningfy-release",
  "activate": { "skills": ["meaningfy-release"], "agents": ["release-manager"], "commands": [
    "git(?:\\s+-[Cc]\\s+\\S+)*\\s+(switch\\s+(-c|--create)|checkout\\s+-b)\\s+(release|hotfix)/",
    "gh release create\\b[^&;|]*\\sv\\d+\\.\\d+",
    "git(?:\\s+-[Cc]\\s+\\S+)*\\s+push\\b(?![^&;|]*\\s(-d|--delete|-n|--dry-run)\\b)[^&;|]*\\sv\\d+\\.\\d+"] },
  "phases": [
    { "id": "branch", "owner": "meaningfy-release", "expect": [], "allow": ["meaningfy-git-workflow"], "gates": ["cut"], "enter": {} },
    { "id": "bump", "owner": "meaningfy-release", "expect": [], "gates": ["bumped"], "enter": {} },
    { "id": "validate", "owner": "meaningfy-release", "expect": [], "gates": ["validated"], "enter": {} },
    { "id": "merge", "owner": "meaningfy-release", "expect": [], "allow": ["meaningfy-git-workflow"], "gates": ["merged"], "enter": {} },
    { "id": "publish", "owner": "meaningfy-release", "expect": [], "allow": ["ci-cd-delivery"], "gates": ["published"], "enter": {} },
    { "id": "back-merge", "owner": "meaningfy-release", "expect": [], "allow": ["meaningfy-git-workflow"], "gates": ["back"], "enter": {} }
  ],
  "gates": {
    "cut": { "kind": "command", "match": "git(?:\\s+-[Cc]\\s+\\S+)*\\s+(switch\\s+(-c|--create)|checkout\\s+-b)\\s+(release|hotfix)/" },
    "bumped": { "kind": "file", "glob": "CHANGELOG.md" },
    "validated": { "kind": "command", "match": "\\bmake validate\\b", "run": "make validate" },
    "merged": { "kind": "command", "match": "gh pr merge" },
    "published": { "kind": "command", "match": "gh release create\\b|git tag\\b(?![^&;|]*\\s(-[dlnv]\\w*|--(delete|list|contains|verify|points-at)\\b))[^&;|]*\\sv\\d|git push\\b(?![^&;|]*\\s(-d|--delete|-n|--dry-run)\\b)[^&;|]*\\s(v\\d|--(follow-)?tags\\b)" },
    "back": { "kind": "command", "match": "gh pr create\\b.*(--base[ =]|-B )develop\\b(?!-)|git merge(?=\\s)[^&;|\"']*\\s(origin/)?(main|release/\\S+|hotfix/\\S+)(\\s|$)" }
  }
}
