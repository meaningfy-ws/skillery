# Use this as <stack>/.env.example: list every variable compose.yml reads, with a placeholder and its source.
# The deploy workflow writes the real .env on the VM from GitHub; never edit .env on the VM.
# Sources: (var X) = Environment variable, (secret X) = Environment secret, (fixed) = set by the workflow.
# Secret values live in the password manager; this file names them, never holds them.

# --- Proxy ---
DNS_API_TOKEN=<placeholder>        # (secret DNS_API_TOKEN) DNS challenge for TLS certificates

# --- <service> ---
DB_PASSWORD=<placeholder>          # (secret DB_PASSWORD) one per instance, never shared with another service
