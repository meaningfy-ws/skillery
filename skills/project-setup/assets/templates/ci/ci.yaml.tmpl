# CI workflow for <<PROJECT_NAME>>
# ============================================================================
# CI is a light lint (about one minute): the spec check and the linters. The
# heavy checks (types, architecture, Semgrep, layout, tests, coverage, builds)
# run locally: `make check-all` runs them in parallel, and the pull request
# body carries its result line. See the project-setup skill, references/ci-and-infra.md.
#
# Thin workflow (decision D12): every step calls a `make` target, never an
# inline tool command. Install only the lint group (`make install-lint`); do
# not add a full install, a test run or a build here.
#
# Runs on push to <<DEFAULT_BRANCH>> and on PRs targeting <<DEFAULT_BRANCH>>.

name: CI

on:
  push:
    branches: [<<DEFAULT_BRANCH>>]
    paths-ignore:
      - "docs/**"
      - "*.md"
      - "LICENSE"
      - ".claude/**"
      - ".mcp.json"
  pull_request:
    branches: [<<DEFAULT_BRANCH>>]
    paths-ignore:
      - "docs/**"
      - "*.md"
      - "LICENSE"
      - ".claude/**"
      - ".mcp.json"

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  lint:
    name: Spec check and lint
    runs-on: ubuntu-latest
    env:
      # `uv run` must not sync the full project: only the lint group is installed.
      UV_NO_SYNC: "1"

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up uv (Python <<PYTHON_VERSION>>)
        uses: astral-sh/setup-uv@v7
        with:
          python-version: "<<PYTHON_VERSION>>"
          enable-cache: true

      - name: Install the lint group
        run: make install-lint

      - name: Spec check (openspec validate --strict)
        run: make validate-spine

      - name: Lint (Ruff)
        run: make lint

      - name: Bindings check
        run: make check-bindings
